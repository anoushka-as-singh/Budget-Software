<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - UNICEF Budget Manager</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">UNICEF Budget Manager</a>
            <div>
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Contract" asp-action="Index">Contracts</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Consultant" asp-action="Index">Consultants</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="BudgetCategory" asp-action="Index">Budget Categories</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ContractBudget" asp-action="Index">Contract Budgets</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Expense" asp-action="Index">Expenses</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Payment" asp-action="Index">Payments</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
    <footer class="footer mt-auto py-3 bg-light text-center">
        <div class="container">
            <span class="text-muted">&copy; UNICEF Budget Manager @(DateTime.Now.Year)</span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
